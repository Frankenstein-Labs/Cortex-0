    "grad_clip": 1.0,
    "eval_interval": 1000,
    "eval_batches": 50,
    "log_interval": 25,
    "seed": 1337,
    "device": "auto",
    "dtype": "auto",
    "checkpoint_dir": "checkpoints",
    "run_name": "cortex-0-base"
