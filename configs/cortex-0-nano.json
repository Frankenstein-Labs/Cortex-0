{
  "model": {
    "vocab_size": 8192,
    "d_model": 192,
    "n_layers": 4,
    "n_heads": 6,
    "n_kv_heads": 2,
    "ffn_mult": 2.6875,
    "max_seq_len": 512,
    "rope_theta": 10000.0,
    "norm_eps": 1e-05,
    "tie_embeddings": true,
    "dropout": 0.0,
    "init_std": 0.02
  },
  "train": {
    "seq_len": 256,
    "batch_size": 32,
    "grad_accum": 2,
    "max_steps": 1200,
    "warmup_steps": 100,
    "learning_rate": 0.002,
    "min_lr_ratio": 0.1,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "eval_interval": 100,
    "eval_batches": 30,
    "log_interval": 25,
    "seed": 1337,
    "device": "cpu",
    "dtype": "float32",
    "checkpoint_dir": "checkpoints",
    "run_name": "cortex-0-nano"
  }
}
